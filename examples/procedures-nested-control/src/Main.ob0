MODULE Main;
VAR current: INTEGER;
PROCEDURE Countdown(start: INTEGER);
BEGIN
  current := start;
  WHILE current DO
    IF current - 1 THEN
      WriteInt(current);
      WriteLn()
    ELSE
      WriteInt(100);
      WriteLn()
    END;
    current := current - 1
  END
END Countdown;
BEGIN
  Countdown(3)
END Main.
