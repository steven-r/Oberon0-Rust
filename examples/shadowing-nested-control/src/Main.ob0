MODULE Main;
IMPORT IO;
VAR x, sum: INTEGER;
PROCEDURE Walk(x: INTEGER);
BEGIN
  sum := 0;
  WHILE x > 0 DO
    IF x > 1 THEN
      sum := sum + x
    ELSE
      sum := sum + 100
    END;
    IO.WriteInt(x);
    IO.WriteLn();
    x := x - 1
  END
END Walk;
BEGIN
  x := 3;
  sum := 0;
  Walk(3);
  IO.WriteInt(x);
  IO.WriteLn();
  IO.WriteInt(sum);
  IO.WriteLn()
END Main.
