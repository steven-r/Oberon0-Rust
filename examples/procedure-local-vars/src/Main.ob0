MODULE Main;
IMPORT IO;
VAR base: INTEGER;

PROCEDURE Accumulate(limit: INTEGER);
VAR i: INTEGER;
VAR total: INTEGER;
BEGIN
  i := limit;
  total := 0;
  WHILE i > 0 DO
    total := total + i;
    i := i - 1
  END;
  IO.WriteInt(total);
  IO.WriteLn()
END Accumulate;

BEGIN
  base := 5;
  Accumulate(base);
  IO.WriteInt(base);
  IO.WriteLn()
END Main.
