MODULE Main;
IMPORT IO;
VAR current: INTEGER;
PROCEDURE Countdown(start: INTEGER);
BEGIN
  current := start;
  WHILE current > 0 DO
    IF current > 1 THEN
      IO.WriteInt(current);
      IO.WriteLn()
    ELSE
      IO.WriteInt(100);
      IO.WriteLn()
    END;
    current := current - 1
  END
END Countdown;
BEGIN
  Countdown(3)
END Main.
