MODULE Main;
VAR x, sum: INTEGER;
PROCEDURE Walk(x: INTEGER);
BEGIN
  sum := 0;
  WHILE x DO
    IF x - 1 THEN
      sum := sum + x
    ELSE
      sum := sum + 100
    END;
    WriteInt(x);
    WriteLn();
    x := x - 1
  END
END Walk;
BEGIN
  x := 3;
  sum := 0;
  Walk(3);
  WriteInt(x);
  WriteLn();
  WriteInt(sum);
  WriteLn()
END Main.
